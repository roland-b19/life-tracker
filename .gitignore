# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Secrets and local config: never commit
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
secrets.*
local.settings.json

# Per-user agent settings. `!.claude/` re-includes the shared Claude Code config
# (hooks, skills) in case a personal global gitignore ignores the whole folder.
!.claude/
.claude/settings.local.json

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Node
node_modules/
dist/
build/
.next/
coverage/
*.tsbuildinfo

# .NET / Java
bin/
obj/
target/

# Terraform / Azure (state can contain secrets)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
.azure/

.neon
.claude/launch.json

# Personal data for scripts/import-personal.cjs (never committed)
/.local/
