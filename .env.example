# Development-only placeholders. Never use these values in production.
POSTGRES_PASSWORD=dev-postgres-password
POSTGRES_OWNER_PASSWORD=dev-owner-password
POSTGRES_APP_PASSWORD=dev-app-password
DATABASE_URL_MIGRATE=postgresql://life_tracker_owner:dev-owner-password@127.0.0.1:5432/life_tracker
DATABASE_URL=postgresql://life_tracker_app:dev-app-password@127.0.0.1:5432/life_tracker
DATABASE_URL_TEST=postgresql://life_tracker_app:dev-app-password@127.0.0.1:5432/life_tracker_test
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-only-secret-change-me
AUTH_DEV=true
# Production OIDC settings. Keep AUTH_DEV=false in production.
AUTH_AZURE_TENANT_ID=
AUTH_AZURE_CLIENT_ID=
AUTH_AZURE_CLIENT_SECRET=
AUTH_ISSUER=
# Key that encrypts each user's Claude token at rest (32 bytes, base64: openssl rand -base64 32). Key Vault on Azure.
CLAUDE_TOKEN_KEY=
# Optional: Claude model alias for the in-app Assistant (default sonnet).
CLAUDE_MODEL=
